{
  "manifest_version": 3,
  "name": "AWS SSO Profiles Switcher",
  "version": "1.0.0",
  "description": "Import your AWS access portal accounts, launch permission sets, and give each profile its own appearance.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "tabGroups"
  ],
  "host_permissions": [
    "https://*.console.aws.amazon.com/*"
  ],
  "optional_host_permissions": [
    "https://*.awsapps.com/*",
    "https://*.app.aws/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AWS SSO Profiles Switcher",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.console.aws.amazon.com/*"
      ],
      "js": [
        "console.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "Command+Shift+Comma"
      }
    }
  }
}
